# code architecture inteligence
.cai

# Terraform plan artifacts written by `ops plans` (SEC-29 / SEC-32:
# secret-dense, never committed)
/.ops/

# READ-5 / TASK-1867: debris from an ingest run against an in-memory DuckDB.
# `data_dir_for_db` now rejects the `:memory:` sentinel, so nothing should
# create this again; the ignore is a belt-and-braces guard against the
# directory being re-committed.
:memory:.ingest/

# Staging files left by interrupted ops text-fixer runs
.ops-text-fixers.*

# TASK-2294: non-Unix allocation lock written by `ops backlog task create
# --unless-exists` into the backlog root. Persistent by design (unlinking it
# would let two holders lock different inodes), so it must not show up as
# untracked noise. Unix builds lock the tasks/ directory and never create it.
.allocation.lock
